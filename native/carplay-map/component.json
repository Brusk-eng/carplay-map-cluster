{
  "id": "carplay-map",
  "kind": "tool",
  "version": "0.2.11",
  "title": "CarPlay map \u2192 cluster",
  "description": "Mirrors CarPlay Dashboard map to the cluster (20\u201322). Accepts light Apple Maps; 1:1 crop; nav clips ETA. Holds last map. Refuses if waze-on-cluster is installed.",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.6.3",
    "cluster-render": "0.2.0"
  },
  "activate": [
    "node",
    "check-conflict.js"
  ],
  "files": [
    {
      "path": "carplay-map-cluster.js",
      "mode": "0755"
    },
    {
      "path": "check-conflict.js",
      "mode": "0755"
    }
  ],
  "units": [
    {
      "name": "carplay-map.service",
      "from": "carplay-map.service"
    }
  ],
  "enable": [
    {
      "unit": "carplay-map.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "carplay-map"
  ],
  "restart": [
    "carplay-map.service"
  ]
}
