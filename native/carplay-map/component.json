{
  "id": "carplay-map",
  "kind": "tool",
  "version": "0.2.4",
  "title": "CarPlay map → cluster",
  "description": "Mirrors the CarPlay Dashboard map onto the instrument cluster via cluster-render. No CarPlay binary patch. Separate from robertn waze-on-cluster — refuse to install/run if that tool is installed (same map slot).",
  "mguHmi": ["ID7"],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.6.3",
    "cluster-render": "0.2.0"
  },
  "activate": ["node", "check-conflict.js"],
  "files": [
    {
      "path": "carplay-map-cluster.js",
      "mode": "0755"
    },
    {
      "path": "check-conflict.js",
      "mode": "0755"
    }
  ],
  "units": [
    {
      "name": "carplay-map.service",
      "from": "carplay-map.service"
    }
  ],
  "enable": [
    {
      "unit": "carplay-map.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": ["carplay-map"],
  "restart": ["carplay-map.service"]
}
