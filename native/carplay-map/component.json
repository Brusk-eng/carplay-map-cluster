{
  "id": "carplay-map",
  "kind": "tool",
  "version": "0.2.10",
  "title": "CarPlay map \u2192 cluster",
  "description": "Mirrors CarPlay Dashboard map to the cluster. 1:1 1088x480 crop + averaged chroma for sharper map; 7 fps for tighter sync. Nav crop clips ETA; free-drive keeps me-arrow. Holds last map when leaving Dashboard. Refuses if waze-on-cluster is installed.",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.6.3",
    "cluster-render": "0.2.0"
  },
  "activate": [
    "node",
    "check-conflict.js"
  ],
  "files": [
    {
      "path": "carplay-map-cluster.js",
      "mode": "0755"
    },
    {
      "path": "check-conflict.js",
      "mode": "0755"
    }
  ],
  "units": [
    {
      "name": "carplay-map.service",
      "from": "carplay-map.service"
    }
  ],
  "enable": [
    {
      "unit": "carplay-map.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "carplay-map"
  ],
  "restart": [
    "carplay-map.service"
  ]
}
