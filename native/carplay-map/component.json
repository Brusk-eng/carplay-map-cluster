{
  "id": "carplay-map",
  "kind": "tool",
  "version": "0.2.13",
  "title": "CarPlay map \u2192 cluster",
  "description": "Mirrors CarPlay Dashboard map on 20\u201322. Keeps me-arrow visible, nudges crop right; rail auto-shift on 21/22; holds last map on home swipe.",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.6.3",
    "cluster-render": "0.2.0"
  },
  "activate": [
    "node",
    "check-conflict.js"
  ],
  "files": [
    {
      "path": "carplay-map-cluster.js",
      "mode": "0755"
    },
    {
      "path": "check-conflict.js",
      "mode": "0755"
    }
  ],
  "units": [
    {
      "name": "carplay-map.service",
      "from": "carplay-map.service"
    }
  ],
  "enable": [
    {
      "unit": "carplay-map.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "carplay-map"
  ],
  "restart": [
    "carplay-map.service"
  ]
}
