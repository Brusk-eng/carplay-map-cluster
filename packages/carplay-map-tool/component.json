{
  "id": "carplay-map",
  "kind": "tool",
  "version": "0.2.9",
  "title": "CarPlay no cluster (produtor)",
  "description": "Mirrors CarPlay Dashboard map apps only (Maps/Waze). Rejects Spotify/media/settings via album-art detection; holds last map. Free-drive crop keeps me-arrow; nav crop clips ETA for look-ahead. Refuses if waze-on-cluster is installed.",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.6.3",
    "cluster-render": "0.2.0"
  },
  "activate": [
    "node",
    "check-conflict.js"
  ],
  "files": [
    {
      "path": "carplay-map-cluster.js",
      "mode": "0755"
    },
    {
      "path": "check-conflict.js",
      "mode": "0755"
    }
  ],
  "units": [
    {
      "name": "carplay-map.service"
    }
  ],
  "enable": [
    {
      "unit": "carplay-map.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "carplay-map"
  ],
  "restart": [
    "carplay-map.service"
  ]
}
