{
  "id": "carplay-map",
  "kind": "tool",
  "version": "0.2.5",
  "title": "CarPlay no cluster (produtor)",
  "description": "Mirrors the CarPlay Dashboard map onto the instrument cluster via cluster-render. Holds the last map frame when you leave Dashboard (e.g. Spotify) until Dashboard returns. Refuses if waze-on-cluster is installed.",
  "files": [
    {
      "path": "carplay-map-cluster.js",
      "mode": "0755"
    },
    {
      "path": "check-conflict.js",
      "mode": "0755"
    }
  ],
  "units": [
    {
      "name": "carplay-map.service"
    }
  ],
  "enable": [
    {
      "unit": "carplay-map.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "carplay-map"
  ],
  "restart": [
    "carplay-map.service"
  ],
  "requires": {
    "mgu-deploy": "0.6.3",
    "cluster-render": "0.2.0"
  },
  "activate": [
    "node",
    "check-conflict.js"
  ],
  "mguHmi": [
    "ID7"
  ]
}
