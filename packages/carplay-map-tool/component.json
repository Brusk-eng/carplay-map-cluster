{
  "id": "carplay-map",
  "kind": "tool",
  "version": "0.2.18",
  "title": "CarPlay no cluster (produtor)",
  "description": "Stable restore of 0.2.10 (working Dashboard mirror). Later detector experiments reverted. 1:1 crop, 7 fps, nav/free crops, hold-last.",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.6.3",
    "cluster-render": "0.2.0"
  },
  "activate": [
    "node",
    "check-conflict.js"
  ],
  "files": [
    {
      "path": "carplay-map-cluster.js",
      "mode": "0755"
    },
    {
      "path": "check-conflict.js",
      "mode": "0755"
    }
  ],
  "units": [
    {
      "name": "carplay-map.service"
    }
  ],
  "enable": [
    {
      "unit": "carplay-map.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "carplay-map"
  ],
  "restart": [
    "carplay-map.service"
  ]
}
